# Copy this file to .env and fill in your values

# MongoDB Atlas connection string (mongodb.com/atlas -> Connect -> Drivers)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/coaching

# Any long random string, keep it secret
JWT_SECRET=change-me-to-a-long-random-string

# Frontend URL(s) allowed to call the API, comma separated
CLIENT_URL=http://localhost:5173

# Optional
PORT=5000
TIMEZONE=Asia/Kolkata
